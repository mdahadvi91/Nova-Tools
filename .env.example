# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / SITE_URL: The URL where this app is hosted (e.g., https://nova-tools.vercel.app).
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is automatically detected.
APP_URL="https://nova-tools.vercel.app"
SITE_URL="https://nova-tools.vercel.app"
VITE_SITE_URL="https://nova-tools.vercel.app"

# GOOGLE_SITE_VERIFICATION: Optional token for Google Search Console meta tag verification.
GOOGLE_SITE_VERIFICATION=""
